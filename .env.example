# Publieke Supabase-clientconfiguratie (nodig voor echte auth/data; leeg = demo-modus)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen server-side. Gebruik nooit de service role key in NEXT_PUBLIC_* variabelen.
SUPABASE_SERVICE_ROLE_KEY=

# Externe prijsprovider. Configureer pas na ontvangst van officiële documentatie.
PRICE_PROVIDER=demo
PRIJSPROFEET_API_KEY=
PRIJSPROFEET_BASE_URL=

# E-mail en geplande taken
RESEND_API_KEY=
RESEND_FROM_EMAIL=MandWijs <weekmail@example.nl>
CRON_SECRET=

# Publieke basis-URL, zonder afsluitende slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configureerbare balanspenalty in eurocenten
SHOPPING_STORE_PENALTY_CENTS=300
