# Publieke Supabase-clientconfiguratie (nodig voor echte auth/data; leeg = demo-modus)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen server-side. Gebruik bij voorkeur een nieuwe Supabase Secret key (`sb_secret_...`)
# of anders de legacy service_role key. Gebruik deze nooit in NEXT_PUBLIC_* variabelen.
SUPABASE_SERVICE_ROLE_KEY=

# Externe prijsprovider. Gebruik `prijsprofeet` voor live zoekdata of `demo` voor volledig lokale data.
PRICE_PROVIDER=demo
PRIJSPROFEET_BASE_URL=https://www.prijsprofeet.nl
PRIJSPROFEET_TIER=free
# Gratis key: hogere eigen limiet op publieke endpoints. Alleen een Pro-key mag /match/* gebruiken.
# Deze key wordt uitsluitend server-side als X-API-Key verzonden.
PRIJSPROFEET_API_KEY=

# Locatieprovider. Verwisselbare server-side endpoints; publieke defaults zijn alleen geschikt voor een bescheiden MVP.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_API_URL=https://overpass.private.coffee/api/interpreter
LOCATION_PROVIDER_USER_AGENT=MandWijs/0.1 (contact: hallo@mandwijs.app)

# E-mail en geplande taken
RESEND_API_KEY=
# Gebruik een adres op een bij Resend geverifieerd eigen domein.
RESEND_FROM_EMAIL=MandWijs <weekmail@updates.jouwdomein.nl>
# Willekeurige geheime waarde van minimaal 16 tekens; Vercel verstuurt deze als Bearer-token.
CRON_SECRET=

# Publieke basis-URL, zonder afsluitende slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configureerbare balanspenalty in eurocenten
SHOPPING_STORE_PENALTY_CENTS=300
